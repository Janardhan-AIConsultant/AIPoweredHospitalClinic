# Copy to .env (never commit .env). Empty integration values = MOCK mode locally.
APP_ENV=local
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
CLINIC_TIMEZONE=Asia/Kolkata

# PostgreSQL (Neon: use the POOLED connection string in production)
DATABASE_URL=
# Direct (non-pooled) URL used by Alembic migrations
DATABASE_URL_UNPOOLED=

# Security (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=
# Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
PHONE_HASH_KEY=
CRON_SECRET=

# Refresh-token cookie. Same-origin proxy deployment (recommended): /api/auth + lax.
# Leave unset for local development (cookie path /auth, SameSite=Lax) or cross-site production (SameSite=None).
# AUTH_COOKIE_PATH=/api/auth
# AUTH_COOKIE_SAMESITE=lax

# Groq (LIVE when key + model are set; preferred over xAI if both are configured)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEMPERATURE=0.0

# Grok / xAI  (LIVE only when both are set)
XAI_API_KEY=
XAI_MODEL=

# Pinecone (LIVE only when PINECONE_API_KEY is set). Index: cosine, dimension 1024 for llama-text-embed-v2.
# `python -m app.rag.ingest` creates the serverless index if it is missing, then loads backend/knowledge/.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=clinic-knowledge
# Optional: the index host from the Pinecone console (skips a name lookup on cold starts).
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=clinic_knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_EMBED_DIMENSION=1024

# WhatsApp Cloud API (LIVE only when token + phone number id are set)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
